# Copy to .env and fill in. NEVER commit .env.
# All scripts source this file (see scripts/lib.sh). Values are never printed.

# --- Internal Red Hat MaaS (upstream model provider, OpenAI-compatible) ---
MAAS_INTERNAL_URL="https://maas.example.internal/v1"     # must end with /v1
MAAS_INTERNAL_API_KEY=""
MAAS_MODEL=""                     # upstream model, chosen after `make model-validate` (POC: qwen3-14b)

# --- OpenShift AI Models-as-a-Service (written by `make maas-keys`) ---
RHOAI_MAAS_URL=""                 # external Route, ends with /v1 (tests from the workstation)
RHOAI_MAAS_INTERNAL_URL=""        # in-cluster gateway Service, ends with /v1 (used by the agent)
AGENT_MAAS_KEY=""                 # key of the agent subscription (quota-limited)
OTHER_CONSUMER_MAAS_KEY=""        # key of a second subscription (Guardrails, test case 5)

# --- OpenClaw ---
OPENCLAW_GATEWAY_TOKEN=""         # generate: python3 -c "import secrets;print(secrets.token_hex(32))"
OPENCLAW_HOOKS_TOKEN=""           # generate: python3 -c "import secrets;print(secrets.token_hex(32))" (used by Alertmanager)
OPENCLAW_HEARTBEAT="30m"          # long interval during the POC (protects the quota)

# --- NeMo Guardrails (standalone, outside the agent path: docs/test-log.md F-09) ---
GUARDRAILS_ALLOWED_CIDRS=""       # cluster egress IP(s) / machine network: only sources allowed on the Guardrails Route

# --- Ansible Automation Platform ---
AAP_GATEWAY_URL=""                # e.g. https://aap-aap.apps.<cluster-domain>
AAP_ADMIN_PASSWORD=""             # read from secret aap/aap-admin-password after install
AAP_AGENT_USER_PASSWORD=""        # password for the restricted 'openclaw-agent' AAP user
AAP_APPROVER_PASSWORD=""          # password for the 'poc-approver' AAP user
AAP_EDA_USER_PASSWORD=""          # password for the 'eda-automation' AAP user
AAP_MCP_TOKEN=""                  # OAuth token of 'openclaw-agent' (written by `make aap-config`)

# --- MLflow ---
MLFLOW_EXPERIMENT_ID=""           # experiment that receives OpenClaw traces (written by scripts/mlflow-experiment.sh)

# --- Git repository used as AAP / EDA project ---
GIT_REPO_URL="https://github.com/<your-user>/poc-openclaw-aiops.git"
GIT_BRANCH="main"

# --- Optional: Slack channel (scripts/slack.sh, manifests/phase3-agent/slack/README.md) ---
SLACK_BOT_TOKEN=""                # xoxb-... Bot User OAuth Token
SLACK_APP_TOKEN=""                # xapp-... App-level token with connections:write (Socket Mode)
SLACK_CHANNEL_ID=""               # channel that receives alerts, e.g. C0123456789
SLACK_OPERATOR_IDS=""             # Slack member IDs allowed to talk to the agent, e.g. "U01AAA U02BBB"

# --- Optional overrides (defaults in the scripts) ---
# GUARDRAILS_MODEL="aiops-model"  # model name Guardrails sends to MaaS
# GUARDRAILS_UPSTREAM_URL=""      # default: RHOAI_MAAS_INTERNAL_URL
# AUTHORINO_TLS="false"           # Authorino listener TLS; breaks RHCL 1.4.3 (test-log F-03)
# MAX_REQUESTS="500"              # upper bound for scripts/quota-burst.sh (case 5)
# SLACK_PLUGIN_SPEC="@openclaw/slack@2026.9.8"
