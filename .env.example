# Copy to .env and fill in. NEVER commit .env.
# All scripts source this file (see scripts/lib.sh).

# --- Internal Red Hat MaaS (upstream model provider, OpenAI-compatible) ---
MAAS_INTERNAL_URL="https://maas.example.internal/v1"     # must end with /v1
MAAS_INTERNAL_API_KEY=""
MAAS_MODEL=""                                             # chosen after model-validation (see docs/installation.md §Phase 0)

# --- OpenShift AI Models-as-a-Service (filled after Phase 2) ---
RHOAI_MAAS_URL=""                 # OpenAI-compatible base URL exposed by RHOAI MaaS (ends with /v1)
AGENT_MAAS_KEY=""                 # key of the agent subscription (quota-limited)
OTHER_CONSUMER_MAAS_KEY=""        # key of a second subscription, used in test case 5

# --- OpenClaw ---
OPENCLAW_GATEWAY_TOKEN=""         # generate: python3 -c "import secrets;print(secrets.token_hex(32))"
OPENCLAW_HOOKS_TOKEN=""           # generate: python3 -c "import secrets;print(secrets.token_hex(32))" (used by Alertmanager)
OPENCLAW_HEARTBEAT="30m"          # long interval during the POC (protects the quota)

# --- NeMo Guardrails ---
GUARDRAILS_ALLOWED_CIDRS=""   # cluster egress IP(s); only source allowed on the Guardrails Route
GUARDRAILS_UPSTREAM_URL=""        # empty = MAAS_INTERNAL_URL (topology A); RHOAI_MAAS_URL for topology B

# --- Ansible Automation Platform ---
AAP_GATEWAY_URL=""                # e.g. https://aap-aap.apps.<cluster-domain>
AAP_ADMIN_PASSWORD=""             # read from secret aap/aap-admin-password after install
AAP_AGENT_USER_PASSWORD=""        # password for the restricted 'openclaw-agent' AAP user
AAP_APPROVER_PASSWORD=""          # password for the 'poc-approver' AAP user
AAP_EDA_USER_PASSWORD=""          # password for the 'eda-automation' AAP user
AAP_MCP_TOKEN=""                  # OAuth token of 'openclaw-agent' (created by aap/config-as-code)
AAP_MCP_URL=""                    # Ansible MCP server Service, e.g. http://aap-mcp.aap.svc:8080/mcp

# --- MLflow ---
MLFLOW_TRACKING_URL=""            # e.g. https://<rhoai-dashboard>/mlflow or internal service URL
MLFLOW_EXPERIMENT_ID=""           # experiment that receives OpenClaw traces
MLFLOW_OTLP_ENDPOINT=""           # OTLP/HTTP traces endpoint (default: $MLFLOW_TRACKING_URL/v1/traces)
MLFLOW_TOKEN=""                   # token of the mlflow-writer ServiceAccount (write traces only)

# --- Git repository used as AAP / EDA project ---
GIT_REPO_URL="https://github.com/<your-user>/poc-openclaw-aiops.git"
GIT_BRANCH="main"
