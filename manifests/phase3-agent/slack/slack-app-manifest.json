{
  "display_information": {
    "name": "OpenClaw AIOps POC",
    "description": "AIOps POC agent: posts alert diagnoses and answers operators in the alert thread"
  },
  "features": {
    "bot_user": { "display_name": "OpenClaw AIOps", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    }
  }
}
