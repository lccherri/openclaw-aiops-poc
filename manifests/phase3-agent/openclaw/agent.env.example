# Non-secret agent settings. Copy to agent.env (git-ignored) - `make agent-env` does it from .env.
# Internal Service address of the RHOAI MaaS gateway (ends with /v1). Fallback: MAAS_INTERNAL_URL.
MAAS_BASE_URL=https://REPLACE_ME/v1
MAAS_MODEL=REPLACE_ME
# Ansible MCP server endpoint (Service in namespace aap)
AAP_MCP_URL=http://REPLACE_ME.aap.svc:8080/mcp
# MLflow OTLP traces endpoint
MLFLOW_OTLP_ENDPOINT=https://REPLACE_ME/v1/traces
MLFLOW_EXPERIMENT_ID=REPLACE_ME
# Long heartbeat during the POC (protects the quota). Test case 5 shortens it.
OPENCLAW_HEARTBEAT=30m
