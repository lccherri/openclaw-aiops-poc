# Non-secret agent settings. The real agent.env (git-ignored) is rendered by `make render`
# from .env. The model key is not here: it comes from the ESO Secret (MAAS_API_KEY).
# Model path: agent -> OpenShift AI MaaS (in-cluster gateway Service, agent subscription).
MAAS_BASE_URL=https://maas-default-gateway-data-science-gateway-class.openshift-ingress.svc.cluster.local/aiops-models/aiops-model/v1
MAAS_MODEL=aiops-model
OPENCLAW_HEARTBEAT=30m
OPENCLAW_PUBLIC_ORIGIN=https://openclaw-openclaw.apps.<cluster-domain>
