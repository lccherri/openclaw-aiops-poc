# Non-secret agent settings (git-ignored agent.env is rendered by `make render` from .env).
# Topology B: the only model endpoint is NeMo Guardrails (in-cluster).
MAAS_BASE_URL=http://aiops-guardrails.aiops-governance.svc/v1
MAAS_MODEL=aiops-model
MAAS_API_KEY=not-used-guardrails-holds-the-key
OPENCLAW_HEARTBEAT=30m
OPENCLAW_PUBLIC_ORIGIN=https://openclaw-openclaw.apps.<cluster-domain>
